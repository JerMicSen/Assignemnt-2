extends layout

block content
  h2 Edit Task

  form(action="/updateListItem" method="POST")
    input(type="hidden" name="userName" value=task.userName)
    input(type="hidden" name="oldTitle" value=task.title)
    input(type="hidden" name="oldDescription" value=task.description)

    label(for="newTitle") Title
    input(
      type="text"
      name="newTitle"
      id="newTitle"
      value=task.title
      required
    )

    label(for="newDescription") Description
    input(
      type="text"
      name="newDescription"
      id="newDescription"
      value=task.description
    )

    label(for="newDueDate") Due Date
    input(
      type="date"
      name="newDueDate"
      id="newDueDate"
    )

    label(for="newPriority") Priority
    select(name="newPriority" id="newPriority" required)
    option(value="Low" selected=task.priority === "Low") Low
    option(value="Medium" selected=task.priority === "Medium") Medium
    option(value="High" selected=task.priority === "High") High

    label(for="newStatus") Status
    select(name="newStatus" id="newStatus")
    option(value="false" selected=!task.status) Pending
    option(value="true" selected=task.status) Completed

    button(type="submit") Save Changes

  a(href="/") Cancel