extends layout

block content
  h2 Task Details

  .task
    h3= task.title
    p Description: #{task.description}
    p Due Date: #{task.dueDate}
    p Priority: #{task.priority}

    if task.status
      p Status: Completed
    else
      p Status: Pending

  a(href="/") Back to Tasks
  a(href="/tasks/edit/" + task._id) Edit Task